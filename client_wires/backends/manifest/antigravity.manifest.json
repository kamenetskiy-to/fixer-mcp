{
  "provider": "antigravity",
  "label": "Google Antigravity CLI",
  "description": "Google Antigravity CLI (agy) provider for the Fixer MCP provider-adapter abstraction. Reasoning is encoded in model display names; MCP isolation relies on project-local config overriding global entries by name.",
  "models": {
    "options": [
      "Gemini 3.8 Flash (Low)",
      "Gemini 3.8 Flash (Medium)",
      "Gemini 3.8 Flash (High)",
      "Gemini 3.7 Flash (Low)",
      "Gemini 3.7 Flash (Medium)",
      "Gemini 3.7 Flash (High)",
      "Gemini 3.6 Flash (Low)",
      "Gemini 3.6 Flash (Medium)",
      "Gemini 3.6 Flash (High)",
      "Gemini 3.1 Pro (Low)",
      "Gemini 3.1 Pro (High)",
      "Claude Sonnet 4.6 (Thinking)",
      "Claude Opus 4.6 (Thinking)"
    ],
    "default": "Gemini 3.7 Flash (Medium)",
    "internal_id_map": {
      "Gemini 3.8 Flash (Low)": "Gemini 3.8 Flash (Low)",
      "Gemini 3.8 Flash (Medium)": "Gemini 3.8 Flash (Medium)",
      "Gemini 3.8 Flash (High)": "Gemini 3.8 Flash (High)",
      "Gemini 3.7 Flash (Low)": "Gemini 3.7 Flash (Low)",
      "Gemini 3.7 Flash (Medium)": "Gemini 3.7 Flash (Medium)",
      "Gemini 3.7 Flash (High)": "Gemini 3.7 Flash (High)",
      "Gemini 3.6 Flash (Low)": "Gemini 3.6 Flash (Low)",
      "Gemini 3.6 Flash (Medium)": "Gemini 3.6 Flash (Medium)",
      "Gemini 3.6 Flash (High)": "Gemini 3.6 Flash (High)",
      "Gemini 3.1 Pro (Low)": "Gemini 3.1 Pro (Low)",
      "Gemini 3.1 Pro (High)": "Gemini 3.1 Pro (High)",
      "Claude Sonnet 4.6 (Thinking)": "Claude Sonnet 4.6 (Thinking)",
      "Claude Opus 4.6 (Thinking)": "Claude Opus 4.6 (Thinking)"
    },
    "byok": false,
    "auth": "subscription"
  },
  "reasoning": {
    "options": [
      "low",
      "medium",
      "high"
    ],
    "default": "high",
    "pass_mechanism": "none",
    "headless_auto_approve_justification": "Antigravity encodes reasoning in the model display-name suffix (Low, Medium, High, Thinking). There is no separate --effort or --reasoning flag."
  },
  "skills": {
    "inject_dir": ".agents/skills",
    "scope_strategy": "pre-clean",
    "scope_flags": []
  },
  "mcp": {
    "config_format": "mcp-config-file",
    "scope_strategy": "pre-clean",
    "scope_flags": []
  },
  "tool_registration": "native",
  "permissions": {
    "interactive_auto_approve_flags": [
      "--dangerously-skip-permissions"
    ],
    "headless_auto_approve_flags": [
      "--dangerously-skip-permissions"
    ]
  },
  "operator_questions": {
    "supported": false,
    "headless_auto_approve_dismisses": false
  },
  "launch": {
    "interactive_cmd_template": "agy --model \"[model]\" --dangerously-skip-permissions --prompt-interactive \"[prompt]\"",
    "headless_cmd_template": "agy --print --output-format json --model \"[model]\" --dangerously-skip-permissions \"[prompt]\"",
    "resume_interactive": "agy --conversation [external_session_id] --dangerously-skip-permissions --prompt-interactive \"[prompt]\"",
    "resume_headless": "agy --print --output-format json --conversation [external_session_id] --model \"[model]\" --dangerously-skip-permissions \"[prompt]\""
  }
}
