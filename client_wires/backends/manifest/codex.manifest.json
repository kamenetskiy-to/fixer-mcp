{
  "provider": "codex",
  "label": "Codex CLI",
  "description": "OpenAI Codex CLI reference provider for the Fixer MCP provider-adapter abstraction.",
  "models": {
    "options": [
      "gpt-5.6-sol",
      "gpt-5.6-terra",
      "gpt-5.6-luna",
      "gpt-5.5",
      "gpt-5.4",
      "gpt-5.4-mini",
      "gpt-5.3-codex",
      "gpt-5.3-codex-spark",
      "gpt-5.2",
      "deepseek/deepseek-v4-flash-0731",
      "opencode-go/glm-5.3-flash",
      "opencode-go/muse-spark-1.2-contributor",
      "opencode-go/deepseek-v4-flash",
      "deepseek/deepseek-v4-pro-0813"
    ],
    "default": "gpt-5.6-luna",
    "internal_id_map": {
      "deepseek/deepseek-v4-flash-0731": "deepseek/deepseek-v4-flash-0731",
      "opencode-go/glm-5.3-flash": "glm-5.3-flash",
      "opencode-go/muse-spark-1.2-contributor": "muse-spark-1.2-contributor",
      "opencode-go/deepseek-v4-flash": "deepseek-v4-flash",
      "deepseek/deepseek-v4-pro-0813": "deepseek/deepseek-v4-pro-0813",
      "gpt-5.6-sol": "gpt-5.6-sol",
      "gpt-5.6-terra": "gpt-5.6-terra",
      "gpt-5.6-luna": "gpt-5.6-luna",
      "gpt-5.5": "gpt-5.5",
      "gpt-5.4": "gpt-5.4",
      "gpt-5.4-mini": "gpt-5.4-mini",
      "gpt-5.3-codex": "gpt-5.3-codex",
      "gpt-5.3-codex-spark": "gpt-5.3-codex-spark",
      "gpt-5.2": "gpt-5.2"
    },
    "config_overrides": {
      "deepseek/deepseek-v4-flash-0731": {
        "model_provider": "openrouter",
        "model_providers.openrouter.name": "OpenRouter",
        "model_providers.openrouter.base_url": "https://openrouter.ai/api/v1",
        "model_providers.openrouter.env_key": "OPENROUTER_API_KEY",
        "model_providers.openrouter.wire_api": "responses",
        "model_catalog_json": "__FIXER_DEEPSEEK_MODEL_CATALOG__",
        "model_context_window": 500000,
        "model_auto_compact_token_limit": 425000
      },
      "opencode-go/deepseek-v4-flash": {
        "model_provider": "opencode_go",
        "model_providers.opencode_go.name": "OpenCode Go",
        "model_providers.opencode_go.base_url": "https://opencode.ai/zen/go/v1",
        "model_providers.opencode_go.env_key": "OPENCODE_GO_API_KEY",
        "model_providers.opencode_go.wire_api": "responses",
        "model_catalog_json": "__FIXER_DEEPSEEK_MODEL_CATALOG__",
        "model_context_window": 500000,
        "model_auto_compact_token_limit": 425000
      },
      "opencode-go/glm-5.3-flash": {
        "model_provider": "opencode_go",
        "model_providers.opencode_go.name": "OpenCode Go",
        "model_providers.opencode_go.base_url": "https://opencode.ai/zen/go/v1",
        "model_providers.opencode_go.env_key": "OPENCODE_GO_API_KEY",
        "model_providers.opencode_go.wire_api": "responses",
        "model_catalog_json": "__FIXER_DEEPSEEK_MODEL_CATALOG__",
        "model_context_window": 262144,
        "model_auto_compact_token_limit": 222822
      },
      "deepseek/deepseek-v4-pro-0813": {
        "model_provider": "openrouter",
        "model_providers.openrouter.name": "OpenRouter",
        "model_providers.openrouter.base_url": "https://openrouter.ai/api/v1",
        "model_providers.openrouter.env_key": "OPENROUTER_API_KEY",
        "model_providers.openrouter.wire_api": "responses",
        "model_catalog_json": "__FIXER_DEEPSEEK_MODEL_CATALOG__",
        "model_context_window": 500000,
        "model_auto_compact_token_limit": 425000
      }
    },
    "byok": false,
    "auth": "api_key",
    "api_key_env": "CODEX_API_KEY"
  },
  "reasoning": {
    "options": ["low", "medium", "high", "xhigh", "max", "ultra"],
    "default": "high",
    "pass_mechanism": "config-key",
    "flag_or_key": "model_reasoning_effort"
  },
  "skills": {
    "inject_dir": ".agents/skills",
    "scope_strategy": "none",
    "scope_flags": []
  },
  "mcp": {
    "config_format": "codex-c-overrides",
    "scope_strategy": "enumerate-disable",
    "scope_flags": [
      "-c",
      "mcp_servers.<n>.enabled=false",
      "--disable",
      "apps"
    ]
  },
  "tool_registration": "native",
  "permissions": {
    "interactive_auto_approve_flags": ["--ask-for-approval", "never"],
    "headless_auto_approve_flags": [
      "--ask-for-approval",
      "never",
      "--dangerously-bypass-approvals-and-sandbox"
    ]
  },
  "operator_questions": {
    "supported": false,
    "headless_auto_approve_dismisses": false
  },
  "launch": {
    "interactive_cmd_template": "codex [prompt]",
    "headless_cmd_template": "codex exec --skip-git-repo-check [prompt]",
    "resume_interactive": "codex fork [external_session_id]",
    "resume_headless": "codex exec resume [external_session_id]"
  }
}
