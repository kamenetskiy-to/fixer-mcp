{
  "manifest_version": 3,
  "name": "Edge MCP — All Tabs",
  "description": "Connects the current Microsoft Edge tabs to the local Playwright MCP relay when that relay is explicitly launched.",
  "version": "0.1.3",
  "key": "",
  "permissions": [
    "alarms",
    "debugger",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "keepalive.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Edge MCP — All Tabs"
  }
}
